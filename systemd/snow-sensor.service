[Unit]
Description=Davies snow-sensor reading
Requires=pigpiod.service
# No RTC: gate on a synced clock or pre-NTP boots write wrong timestamps.
# Real gate needs systemd-time-wait-sync enabled (deploy.sh does this);
# without it time-sync.target only means timesyncd started.
Wants=time-sync.target
After=pigpiod.service time-sync.target

[Service]
Type=oneshot
# Oneshot start timeout is otherwise infinite; a wedged serial read or GPIO
# wait must not block the next timer slot. Worst honest cycle is ~3 min.
TimeoutStartSec=10min
User=admin
SupplementaryGroups=gpio spi i2c dialout
RuntimeDirectory=snow-sensor
WorkingDirectory=/run/snow-sensor
Environment=GPIOZERO_PIN_FACTORY=pigpio
ExecStart=/home/admin/davies-snow-sensor/venv/bin/python -m snowsensor.sensor.main --config /home/admin/davies-snow-sensor/config/station.yaml
StandardOutput=journal
StandardError=journal
SyslogIdentifier=snow-sensor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
